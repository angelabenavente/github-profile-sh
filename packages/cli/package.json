{
  "name": "github-profile-sh",
  "version": "1.0.0",
  "description": "Animated GitHub profile stats rendered as a terminal.",
  "type": "module",
  "bin": {
    "github-profile-sh": "./dist/index.js"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelabenavente/github-profile-sh.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/angelabenavente/github-profile-sh#readme",
  "bugs": {
    "url": "https://github.com/angelabenavente/github-profile-sh/issues"
  },
  "keywords": [
    "github",
    "profile",
    "readme",
    "svg",
    "cli"
  ],
  "scripts": {
    "build": "ncc build src/index.ts -o dist",
    "dev": "ncc build src/index.ts -o dist && node dist/index.js",
    "prepack": "ncc build src/index.ts -o dist",
    "pack": "npm pack"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@github-profile-sh/core": "workspace:*",
    "@types/node": "^24.3.0",
    "@vercel/ncc": "^0.38.4",
    "cac": "^7.0.0"
  }
}
